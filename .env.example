# ─────────────────────────────────────────────────────────────
# QO'LLAB — environment variables
# Copy to `.env` for local development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (local, Supabase, Neon, Vercel Postgres, Railway…)
# With a connection pooler (Supabase/Neon pooled URL) use it here and the direct URL below.
DATABASE_URL="postgresql://qollab:qollab@localhost:5432/qollab?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL when not pooling.
DIRECT_URL="postgresql://qollab:qollab@localhost:5432/qollab?schema=public"

# Public base URL of the app (used for OAuth callbacks, emails, sitemap, CSRF origin checks)
APP_URL="http://localhost:3000"

# REQUIRED in production: 32+ random characters. Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_MAX_AGE_DAYS=30

# Demo mode: enables one-click demo accounts on the login page (hackathon / pitch).
# Set to "false" for a real production launch.
DEMO_MODE="true"
# Password used by `npm run db:seed` for all seeded accounts (local/demo only).
DEMO_PASSWORD="Demo12345!"

# All dates are rendered in this time zone (server and browser agree → no hydration drift)
NEXT_PUBLIC_APP_TIMEZONE="Asia/Tashkent"

# ── Google OAuth (optional) ─────────────────────────────────
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── File storage ────────────────────────────────────────────
# "local" stores uploads on disk (single server / development).
# "supabase" stores them in Supabase Storage (recommended on Vercel — the filesystem is read-only there).
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"
UPLOAD_MAX_BYTES=5242880
SUPABASE_URL=""
# Server-side only. Never expose the service-role key to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="qollab-uploads"

# ── Email notifications (optional) ──────────────────────────
# "console" logs emails in development; "resend" delivers via https://resend.com
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="QO'LLAB <noreply@your-domain.uz>"

# ── Rate limiting (optional, recommended for serverless) ────
# Without these, an in-memory limiter is used (per instance).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── AI-assisted classification (optional) ───────────────────
# Suggests category + urgency on the request form. Falls back to the keyword classifier when empty.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# ── Map tiles (optional) ────────────────────────────────────
# Default: free CARTO Voyager tiles (OpenStreetMap data) — fine for demos / low traffic.
# Production example (MapTiler): https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_ATTRIBUTION=""

# ── Tests ───────────────────────────────────────────────────
TEST_DATABASE_URL="postgresql://qollab:qollab@localhost:5432/qollab_test?schema=public"
E2E_DATABASE_URL="postgresql://qollab:qollab@localhost:5432/qollab_e2e?schema=public"
